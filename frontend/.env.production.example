# Salin ke frontend/.env.production.local di server:
#   cp frontend/.env.production.example frontend/.env.production.local
# Ganti nofosys.id dengan domain platform Anda. Setelah mengubah file ini, build ulang website (npm run build).

# Alamat API yang dipakai browser: /api di domain yang sama (lewat Nginx),
# sehingga berlaku untuk semua domain lembaga (subdomain & domain kustom)
NEXT_PUBLIC_API_URL=/api
# Alamat website cadangan (preview link memakai domain yang sedang dibuka)
NEXT_PUBLIC_SITE_URL=https://nofosys.id
# Alamat API untuk server-side rendering (langsung ke API di server yang sama)
API_URL=http://127.0.0.1:4000
