# Salin ke frontend/.env.production.local di server:
#   cp frontend/.env.production.example frontend/.env.production.local
# Ganti mentalenglish.id dengan domain Anda. Setelah mengubah file ini, build ulang website (npm run build).

# Alamat API yang dipakai browser (lewat Nginx)
NEXT_PUBLIC_API_URL=https://mentalenglish.id/api
# Alamat website (untuk gambar preview link / OG image)
NEXT_PUBLIC_SITE_URL=https://mentalenglish.id
# Alamat API untuk server-side rendering (langsung ke API di server yang sama)
API_URL=http://127.0.0.1:4000
