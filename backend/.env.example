PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nofosys
JWT_SECRET=ganti-dengan-secret-yang-panjang
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://*.localhost:3000
# false = skema dikelola lewat migrasi (disarankan). true = sinkron otomatis, hanya untuk eksperimen lokal
DB_SYNC=false
PUBLIC_URL=http://localhost:4000

# Multi-lembaga: organisasi dikenali dari domain.
# DEFAULT_ORG = slug organisasi untuk domain yang tidak dikenal (mis. http://localhost:3000)
DEFAULT_ORG=mental-english
# Domain platform untuk subdomain klien: <slug>.PLATFORM_DOMAIN (kosongkan saat pengembangan; <slug>.localhost selalu berlaku)
PLATFORM_DOMAIN=
