# Salin ke backend/.env di server:  cp backend/.env.production.example backend/.env
# Buat nilai acak:  openssl rand -hex 32

PORT=4000
# Hanya bisa diakses dari server sendiri (lewat Nginx)
HOST=127.0.0.1

# Database PostgreSQL lokal (user & password dibuat di langkah DEPLOY.md)
DATABASE_URL=postgres://mental:GANTI_PASSWORD_DB@127.0.0.1:5432/mental_english
# Struktur database lewat migrasi (otomatis saat API start)
DB_SYNC=false

JWT_SECRET=GANTI_dengan_hasil_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Website memanggil API lewat /api di domain yang sama, jadi CORS praktis tidak dipakai
CORS_ORIGIN=https://*.mentalenglish.id
# Alamat file unggahan: relatif agar berlaku di semua domain lembaga
PUBLIC_URL=/api

# ---- Multi-lembaga ----
# Domain platform: klien dapat subdomain <slug>.PLATFORM_DOMAIN (mis. mental-english.mentalenglish.id)
PLATFORM_DOMAIN=mentalenglish.id
# Lembaga untuk domain yang tidak dikenal (mis. domain utama). Kosongkan bila domain utama bukan milik satu lembaga.
DEFAULT_ORG=mental-english

# Password akun demo / Super Admin saat menjalankan seed (jangan password123)
SEED_PASSWORD=GANTI_password_kuat
