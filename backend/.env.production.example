# Salin ke backend/.env di server:  cp backend/.env.production.example backend/.env
# Buat nilai acak:  openssl rand -hex 32

PORT=4000
# Hanya bisa diakses dari server sendiri (lewat Nginx)
HOST=127.0.0.1

# Database PostgreSQL lokal (user & password dibuat di langkah DEPLOY.md)
DATABASE_URL=postgres://nofosys:GANTI_PASSWORD_DB@127.0.0.1:5432/nofosys
# Struktur database lewat migrasi (otomatis saat API start)
DB_SYNC=false

JWT_SECRET=GANTI_dengan_hasil_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# Website memanggil API lewat /api di domain yang sama, jadi CORS praktis tidak dipakai
CORS_ORIGIN=https://*.nofosys.id
# Alamat file unggahan: relatif agar berlaku di semua domain lembaga
PUBLIC_URL=/api

# ---- Multi-lembaga ----
# Domain platform Nofosys. https://nofosys.id = website produk + panel pengelola (/platform),
# setiap klien otomatis dapat subdomain https://<slug>.nofosys.id (mis. mental-english.nofosys.id)
PLATFORM_DOMAIN=nofosys.id
PLATFORM_NAME=Nofosys
# Kontak di website produk (tombol "Hubungi kami"), opsional
PLATFORM_WHATSAPP=
PLATFORM_EMAIL=
# Lembaga untuk domain tak dikenal — kosongkan di production (domain tak dikenal = 404)
DEFAULT_ORG=

# Password akun demo, Super Admin, & pengelola platform saat menjalankan seed (jangan password123)
SEED_PASSWORD=GANTI_password_kuat
# Email akun pengelola platform yang dibuat seed (panel https://nofosys.id/platform)
SEED_PLATFORM_EMAIL=owner@nofosys.id
