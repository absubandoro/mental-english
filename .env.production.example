# Salin menjadi .env di folder root project (sejajar docker-compose.prod.yml):
#   cp .env.production.example .env
# Buat nilai acak dengan:  openssl rand -hex 32

# Domain website TANPA https:// (DNS A record domain harus mengarah ke IP VPS)
DOMAIN=mentalenglish.id

# Password database — gunakan huruf & angka saja (hasil openssl rand -hex 24)
POSTGRES_PASSWORD=ganti-dengan-hasil-openssl-rand-hex-24

# Kunci rahasia login — minimal 32 karakter acak (openssl rand -hex 32)
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# Password untuk SEMUA akun demo saat menjalankan seed (jangan pakai password123)
SEED_PASSWORD=ganti-dengan-password-kuat
